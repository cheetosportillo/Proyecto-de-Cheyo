+    $a = Kardex::registrarSalida($id, 'SALIDA', 1, 1);
+    $b = Kardex::registrarSalida($id, 'SALIDA', 1, 1);
+    $c = Kardex::registrarSalida($id, 'SALIDA', 1, 1);
