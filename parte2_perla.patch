@@ -0,0 +1,19 @@
+# Parte 2 · Cómo instalar
+
+1. `git apply parte2_perla.patch` (o copia los archivos del .zip respetando las rutas) en tu rama **Perla**.
+2. Ejecuta **una sola vez**: `mysql -u root -P 3307 -h 127.0.0.1 joyeria_onix < database/migracion_parte2.sql`
+   (en phpMyAdmin: pestaña Importar). Haz antes un respaldo de la BD.
+3. Pruebas (BD aparte que termine en `_test`):
+   ```
+   mysql -u root -P 3307 -h 127.0.0.1 -e "CREATE DATABASE joyeria_onix_test CHARACTER SET utf8mb4"
+   mysql ... joyeria_onix_test < joyeria_onix.sql && mysql ... joyeria_onix_test < database/migracion_parte2.sql
+   php tests/run.php
+   ```
+   Variables opcionales: ONIX_DB_HOST, ONIX_DB_PORT, ONIX_DB_USER, ONIX_DB_PASS, ONIX_DB_NAME.
+
+## Piezas de la Parte 1 que este código asume
+- `app/core/Permisos.php` es un SHIM (dueña = todo; cajero = ventas.cobrar, ventas.reimprimir, inventario.consultar, caja.operar).
+  Si ya tienen su `Permisos::tiene($permiso)`, borren el shim y su `require` en index.php.
+- `Backup::generarAutomatico()` se llama al cerrar caja SOLO si la clase existe.
+- `Config::obtener($clave, $defecto)` (negocio_nombre, negocio_direccion) se usa en el ticket SOLO si existe.
+- `Offline.guardarCatalogo(items)`, `Offline.buscarCatalogo(q, cat)`, `Offline.guardarVentaPendiente(payload)` se usan en ventas.js SOLO si existe `Offline`.
diff --git a/database/migracion_parte2.sql b/database/migracion_parte2.sql
new file mode 100644
index 0000000..7a0e443
--- /dev/null
+++ b/database/migracion_parte2.sql
@@ -0,0 +1,154 @@
+-- =====================================================================
+-- Joyería Onix · MIGRACIÓN PARTE 2 (Kardex CPP, Caja, Ventas, Compras)
+-- Ejecutar UNA SOLA VEZ sobre joyeria_onix.sql (rama Perla).
+--   mysql -u root -P 3307 -h 127.0.0.1 joyeria_onix < database/migracion_parte2.sql
+-- Compatible con MariaDB 10.4+.
+-- =====================================================================
+SET NAMES utf8mb4;
+
+-- ---------- CATEGORÍAS: unidad de peso única, peso mínimo, baja lógica ----------
+ALTER TABLE categorias
+  ADD COLUMN unidad_peso ENUM('gramos','kilates') NOT NULL DEFAULT 'gramos' AFTER nombre,
+  ADD COLUMN peso_minimo DECIMAL(12,3) NOT NULL DEFAULT 0.000 AFTER stock_minimo,
+  ADD COLUMN estado TINYINT(1) NOT NULL DEFAULT 1;
+
+-- La unidad de cada categoría se toma de la que ya usaban sus productos
+UPDATE categorias c SET c.unidad_peso = COALESCE(
+  (SELECT p.unidad_peso FROM productos p WHERE p.id_categoria = c.id_categoria
+   GROUP BY p.unidad_peso ORDER BY COUNT(*) DESC LIMIT 1), 'gramos');
+
+-- ---------- PRODUCTOS ----------
+ALTER TABLE productos
+  MODIFY peso DECIMAL(12,3) NOT NULL DEFAULT 0.000,
+  MODIFY costo DECIMAL(14,4) NOT NULL DEFAULT 0.0000,   -- solo caché informativa = CPP vigente
+  DROP COLUMN unidad_peso;                              -- ahora se deriva por JOIN con categorias
+
+-- ---------- PROVEEDORES ----------
+ALTER TABLE proveedores MODIFY telefono VARCHAR(30) DEFAULT NULL;
+
+-- ---------- SECUENCIAS (tickets sin huecos) ----------
+CREATE TABLE secuencias (
+  nombre VARCHAR(30) NOT NULL PRIMARY KEY,
+  valor  INT NOT NULL DEFAULT 0
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+INSERT INTO secuencias (nombre, valor) VALUES ('ticket', 0);
+
+-- ---------- CAJA ÚNICA ----------
+CREATE TABLE cajas (
+  id_caja INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
+  id_usuario_apertura INT NOT NULL,
+  fecha_apertura DATETIME NOT NULL DEFAULT current_timestamp(),
+  monto_inicial DECIMAL(12,2) NOT NULL DEFAULT 0.00,
+  estado ENUM('ABIERTA','CERRADA') NOT NULL DEFAULT 'ABIERTA',
+  fecha_cierre DATETIME DEFAULT NULL,
+  id_usuario_cierre INT DEFAULT NULL,
+  efectivo_esperado DECIMAL(12,2) DEFAULT NULL,
+  efectivo_contado DECIMAL(12,2) DEFAULT NULL,
+  diferencia DECIMAL(12,2) DEFAULT NULL,
+  abierta_unica TINYINT(1) AS (IF(estado = 'ABIERTA', 1, NULL)) PERSISTENT,
+  UNIQUE KEY uk_una_caja_abierta (abierta_unica),      -- solo puede existir 1 caja abierta
+  CONSTRAINT fk_cajas_usr_ap FOREIGN KEY (id_usuario_apertura) REFERENCES usuarios (id_usuario),
+  CONSTRAINT fk_cajas_usr_ci FOREIGN KEY (id_usuario_cierre) REFERENCES usuarios (id_usuario)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+
+-- ---------- VENTAS ----------
+ALTER TABLE ventas
+  ADD COLUMN uuid_operacion CHAR(36) DEFAULT NULL,
+  ADD COLUMN numero_ticket INT DEFAULT NULL,
+  ADD COLUMN id_caja INT DEFAULT NULL,
+  ADD COLUMN estado ENUM('ACTIVA','ANULADA') NOT NULL DEFAULT 'ACTIVA',
+  ADD COLUMN motivo_anulacion VARCHAR(255) DEFAULT NULL,
+  ADD COLUMN id_usuario_anula INT DEFAULT NULL,
+  ADD COLUMN fecha_anulacion DATETIME DEFAULT NULL,
+  ADD COLUMN impresiones INT NOT NULL DEFAULT 0,
+  ADD UNIQUE KEY uk_ventas_uuid (uuid_operacion),
+  ADD UNIQUE KEY uk_ventas_ticket (numero_ticket),
+  ADD KEY idx_ventas_fecha (fecha),
+  ADD KEY idx_ventas_caja (id_caja),
+  ADD CONSTRAINT fk_ventas_caja FOREIGN KEY (id_caja) REFERENCES cajas (id_caja);
+UPDATE ventas SET numero_ticket = id_venta WHERE numero_ticket IS NULL;
+UPDATE secuencias SET valor = COALESCE((SELECT MAX(numero_ticket) FROM ventas), 0) WHERE nombre = 'ticket';
+
+-- ---------- DETALLE DE VENTA: foto histórica ----------
+ALTER TABLE detalle_venta
+  MODIFY peso DECIMAL(12,3) NOT NULL DEFAULT 0.000,
+  ADD COLUMN codigo VARCHAR(50) NOT NULL DEFAULT '' AFTER id_producto,
+  ADD COLUMN nombre VARCHAR(150) NOT NULL DEFAULT '' AFTER codigo,
+  ADD COLUMN costo_unitario DECIMAL(14,4) NOT NULL DEFAULT 0.0000,
+  ADD COLUMN costo_total DECIMAL(14,2) NOT NULL DEFAULT 0.00;
+UPDATE detalle_venta d JOIN productos p ON p.id_producto = d.id_producto
+   SET d.codigo = p.codigo, d.nombre = p.nombre;
+
+-- ---------- COMPRAS ----------
+ALTER TABLE compras
+  ADD COLUMN uuid_operacion CHAR(36) DEFAULT NULL,
+  ADD COLUMN numero_factura VARCHAR(40) DEFAULT NULL,
+  ADD COLUMN estado ENUM('ACTIVA','ANULADA') NOT NULL DEFAULT 'ACTIVA',
+  ADD COLUMN motivo_anulacion VARCHAR(255) DEFAULT NULL,
+  ADD COLUMN id_usuario_anula INT DEFAULT NULL,
+  ADD COLUMN fecha_anulacion DATETIME DEFAULT NULL,
+  ADD UNIQUE KEY uk_compras_uuid (uuid_operacion),
+  ADD UNIQUE KEY uk_compras_factura (id_proveedor, numero_factura);   -- factura única por proveedor
+ALTER TABLE detalle_compra MODIFY costo_unitario DECIMAL(14,4) NOT NULL DEFAULT 0.0000;
+
+-- ---------- KARDEX (costo promedio ponderado) ----------
+CREATE TABLE kardex (
+  id_kardex BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,
+  id_producto INT NOT NULL,
+  fecha DATETIME NOT NULL DEFAULT current_timestamp(),
+  tipo ENUM('SALDO_INICIAL','ENTRADA','AJUSTE_ENTRADA','ANULACION_VENTA',
+            'SALIDA','AJUSTE_SALIDA','ANULACION_COMPRA') NOT NULL,
+  cantidad INT NOT NULL,
+  peso_mov DECIMAL(14,3) NOT NULL DEFAULT 0.000,
+  unidad_peso ENUM('gramos','kilates') NOT NULL,            -- foto de la unidad en ese momento
+  costo_unitario DECIMAL(14,4) NOT NULL,
+  valor_total DECIMAL(14,2) NOT NULL,
+  saldo_cantidad INT NOT NULL,
+  saldo_peso DECIMAL(14,3) NOT NULL,
+  saldo_monetario DECIMAL(14,2) NOT NULL,
+  cpp DECIMAL(14,4) NOT NULL,
+  ref_tipo VARCHAR(20) DEFAULT NULL,
+  ref_id INT DEFAULT NULL,
+  motivo VARCHAR(255) DEFAULT NULL,
+  id_usuario INT DEFAULT NULL,
+  KEY idx_kardex_prod (id_producto, id_kardex),
+  KEY idx_kardex_fecha (fecha),
+  CONSTRAINT fk_kardex_prod FOREIGN KEY (id_producto) REFERENCES productos (id_producto),
+  CONSTRAINT fk_kardex_usr FOREIGN KEY (id_usuario) REFERENCES usuarios (id_usuario)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+
+-- Productos que ya tenían stock antes del Kardex entran como SALDO_INICIAL
+INSERT INTO kardex (id_producto, tipo, cantidad, peso_mov, unidad_peso, costo_unitario, valor_total,
+                    saldo_cantidad, saldo_peso, saldo_monetario, cpp, ref_tipo, motivo)
+SELECT p.id_producto, 'SALDO_INICIAL', p.stock, ROUND(p.peso * p.stock, 3), c.unidad_peso,
+       ROUND(p.costo, 4), ROUND(p.costo * p.stock, 2),
+       p.stock, ROUND(p.peso * p.stock, 3), ROUND(p.costo * p.stock, 2), ROUND(p.costo, 4),
+       'MIGRACION', 'Saldo previo a la migración al Kardex'
+FROM productos p JOIN categorias c ON c.id_categoria = p.id_categoria
+WHERE p.stock > 0;
+
+-- ---------- CAJA: movimientos de efectivo ----------
+CREATE TABLE caja_movimientos (
+  id_movimiento INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
+  id_caja INT NOT NULL,
+  tipo ENUM('INGRESO','RETIRO','GASTO','DEVOLUCION') NOT NULL,
+  monto DECIMAL(12,2) NOT NULL,
+  motivo VARCHAR(255) NOT NULL,
+  id_venta INT DEFAULT NULL,
+  id_usuario INT NOT NULL,
+  fecha DATETIME NOT NULL DEFAULT current_timestamp(),
+  KEY idx_mov_caja (id_caja),
+  CONSTRAINT fk_mov_caja FOREIGN KEY (id_caja) REFERENCES cajas (id_caja),
+  CONSTRAINT fk_mov_venta FOREIGN KEY (id_venta) REFERENCES ventas (id_venta),
+  CONSTRAINT fk_mov_usr FOREIGN KEY (id_usuario) REFERENCES usuarios (id_usuario)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+
+-- ---------- BITÁCORA ----------
+CREATE TABLE IF NOT EXISTS bitacora (
+  id_bitacora INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
+  fecha DATETIME NOT NULL DEFAULT current_timestamp(),
+  id_usuario INT DEFAULT NULL,
+  accion VARCHAR(60) NOT NULL,
+  detalle VARCHAR(500) DEFAULT NULL,
+  KEY idx_bit_fecha (fecha)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
