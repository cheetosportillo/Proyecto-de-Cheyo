diff --git a/app/controllers/CajaController.php b/app/controllers/CajaController.php
new file mode 100644
index 0000000..0b06815
--- /dev/null
+++ b/app/controllers/CajaController.php
@@ -0,0 +1,58 @@
+<?php
+require_once __DIR__ . '/../models/Bitacora.php';
+require_once __DIR__ . '/../models/Caja.php';
+
+/** Caja única: apertura, movimientos de efectivo y cierre/arqueo. Permiso: caja.operar */
+class CajaController extends Controller
+{
+    public function index(): void
+    {
+        $this->requirePermiso('caja.operar');
+        $caja = Caja::abierta();
+        $this->render('caja/index', [
+            'titulo'      => 'Caja',
+            'caja'        => $caja,
+            'resumen'     => $caja ? Caja::resumen((int)$caja['id_caja']) : null,
+            'movimientos' => $caja ? Caja::movimientos((int)$caja['id_caja']) : [],
+            'historial'   => Caja::historial(),
+        ]);
+    }
+
+    public function abrir(): void
+    {
+        $this->requirePermiso('caja.operar', true);
+        $this->verificarCsrf();
+        $monto = $this->entrada()['monto_inicial'] ?? '';
+        if (!is_numeric($monto) || (float)$monto < 0 || (float)$monto > 9999999.99) $this->json(['ok' => false, 'msg' => 'Ingresa un monto inicial válido (0 o más).']);
+        try { Caja::abrir($this->usuario()['id'], a_centavos($monto)); }
+        catch (RuntimeException $e) { $this->json(['ok' => false, 'msg' => $e->getMessage()]); }
+        $this->json(['ok' => true, 'msg' => 'Caja abierta. Ya puedes cobrar.']);
+    }
+
+    public function movimiento(): void
+    {
+        $this->requirePermiso('caja.operar', true);
+        $this->verificarCsrf();
+        $d = $this->entrada();
+        $monto = $d['monto'] ?? '';
+        if (!is_numeric($monto) || (float)$monto <= 0 || (float)$monto > 9999999.99) $this->json(['ok' => false, 'msg' => 'Ingresa un monto mayor a 0.']);
+        try { Caja::movimiento($this->usuario()['id'], (string)($d['tipo'] ?? ''), a_centavos($monto), (string)($d['motivo'] ?? '')); }
+        catch (RuntimeException $e) { $this->json(['ok' => false, 'msg' => $e->getMessage()]); }
+        $this->json(['ok' => true, 'msg' => 'Movimiento registrado.']);
+    }
+
+    public function cerrar(): void
+    {
+        $this->requirePermiso('caja.operar', true);
+        $this->verificarCsrf();
+        $contado = $this->entrada()['efectivo_contado'] ?? '';
+        if (!is_numeric($contado) || (float)$contado < 0) $this->json(['ok' => false, 'msg' => 'Ingresa el efectivo contado.']);
+        try { $r = Caja::cerrar($this->usuario()['id'], a_centavos($contado)); }
+        catch (RuntimeException $e) { $this->json(['ok' => false, 'msg' => $e->getMessage()]); }
+        $dif = $r['diferencia'];
+        $this->json(['ok' => true,
+            'msg' => 'Caja cerrada. Esperado ' . money(de_centavos($r['resumen']['esperado'])) . ' · contado ' . money(de_centavos($r['contado']))
+                   . ' · ' . ($dif === 0 ? 'cuadra exacto' : ($dif > 0 ? 'sobrante ' : 'faltante ') . money(de_centavos(abs($dif))))
+                   . ($r['backup'] ? ' · respaldo automático generado.' : '')]);
+    }
+}
diff --git a/app/controllers/CategoriaController.php b/app/controllers/CategoriaController.php
new file mode 100644
index 0000000..8454fed
--- /dev/null
+++ b/app/controllers/CategoriaController.php
@@ -0,0 +1,53 @@
+<?php
+require_once __DIR__ . '/../models/Kardex.php';
+require_once __DIR__ . '/../models/Categoria.php';
+require_once __DIR__ . '/../models/Bitacora.php';
+
+/** CRUD web de categorías (pestaña «Categorías» del Inventario). Permiso: inventario.gestionar */
+class CategoriaController extends Controller
+{
+    public function guardar(): void
+    {
+        $this->requirePermiso('inventario.gestionar', true);
+        $this->verificarCsrf();
+        $d = $this->entrada();
+
+        $id     = (int)($d['id_categoria'] ?? 0);
+        $nombre = trim($d['nombre'] ?? '');
+        $unidad = $d['unidad_peso'] ?? 'gramos';
+        $stockMin = (int)($d['stock_minimo'] ?? 0);
+        $pesoMin  = (float)($d['peso_minimo'] ?? 0);
+
+        if ($nombre === '' || largo_texto($nombre) > 100) $this->json(['ok' => false, 'msg' => 'El nombre es obligatorio (máx. 100 caracteres).']);
+        if (!in_array($unidad, ['gramos', 'kilates'], true)) $this->json(['ok' => false, 'msg' => 'Unidad de peso no válida.']);
+        if ($stockMin < 0 || $stockMin > 1000000 || $pesoMin < 0 || $pesoMin > 99999999.999)
+            $this->json(['ok' => false, 'msg' => 'El stock mínimo y el peso mínimo deben ser números positivos razonables.']);
+        if (Categoria::existe($nombre, $id)) $this->json(['ok' => false, 'msg' => 'Ya existe una categoría con ese nombre.']);
+
+        $datos = ['nombre' => $nombre, 'unidad_peso' => $unidad, 'stock_minimo' => $stockMin, 'peso_minimo' => number_format($pesoMin, 3, '.', '')];
+        try {
+            if ($id > 0) Categoria::actualizar($id, $datos); else Categoria::crear($datos);
+        } catch (RuntimeException $e) { $this->json(['ok' => false, 'msg' => $e->getMessage()]); }
+        Bitacora::registrar($this->usuario()['id'], $id > 0 ? 'CATEGORIA_EDITADA' : 'CATEGORIA_CREADA', $nombre);
+        $this->json(['ok' => true, 'msg' => 'Categoría guardada correctamente.']);
+    }
+
+    public function baja(): void
+    {
+        $this->requirePermiso('inventario.gestionar', true);
+        $this->verificarCsrf();
+        $id = (int)($this->entrada()['id_categoria'] ?? 0);
+        try { Categoria::baja($id); }
+        catch (RuntimeException $e) { $this->json(['ok' => false, 'msg' => $e->getMessage()]); }
+        Bitacora::registrar($this->usuario()['id'], 'CATEGORIA_BAJA', "id $id");
+        $this->json(['ok' => true, 'msg' => 'Categoría dada de baja.']);
+    }
+
+    public function reactivar(): void
+    {
+        $this->requirePermiso('inventario.gestionar', true);
+        $this->verificarCsrf();
+        Categoria::reactivar((int)($this->entrada()['id_categoria'] ?? 0));
+        $this->json(['ok' => true, 'msg' => 'Categoría reactivada.']);
+    }
+}
